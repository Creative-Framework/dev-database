{
  "name": "dev-database",
  "version": "2.0.0",
  "description": "A high-performance, typed JSON file-based database with events, collections, dot notation, TTL, math/array operations, and zero dependencies. Perfect for Discord bots, small projects, and prototyping.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rmdir /s /q dist 2>nul || true",
    "rebuild": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Creative-Framework/dev-database.git"
  },
  "keywords": [
    "database",
    "json",
    "json-database",
    "db",
    "storage",
    "key-value",
    "lightweight",
    "typescript",
    "discord",
    "discord-bot",
    "collections",
    "events",
    "ttl",
    "dot-notation",
    "nosql",
    "embedded-database",
    "file-database"
  ],
  "author": "amtixdev",
  "license": "MIT",
  "homepage": "https://github.com/Creative-Framework/dev-database#readme",
  "bugs": {
    "url": "https://github.com/Creative-Framework/dev-database/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.8.3"
  }
}
